{
  "name": "racketeers-badminton",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-ocr.mjs",
    "predev:worker": "node scripts/prepare-ocr.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "dev": "vite --config vite.preview.config.ts",
    "build": "vinext build",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "test": "node --test tests/tournament-logic.test.mjs tests/payment-proof.test.mjs tests/request-security.test.mjs tests/registration-access.test.mjs tests/registration-ui.test.mjs tests/registration-draft.test.mjs tests/registration-export.test.mjs tests/projector.test.mjs tests/projector-viewport.test.mjs tests/sponsors.test.mjs tests/game-day.test.mjs tests/print-match-card.test.mjs tests/court-ocr.test.mjs tests/reliability.test.mjs tests/receipt-reader.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:worker": "vite"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/eng": "1.0.0",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.7.4",
    "next": "16.2.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vinext/cloudflare": "1.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "4.20260730.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Racketeers Badminton Tournament Tracker"
}
