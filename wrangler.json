{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racketeers",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "racketeers-db",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ]
}
