{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racketeers",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "racketeers-db",
      "database_id": "b58e6311-5f06-42ee-a633-b7b37dbcb218"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYMENT_PROOFS",
      "bucket_name": "racketeers-payments"
    }
  ]
}
